# --- データベース ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/research_agent

# --- Auth.js ---
# `npx auth secret` で生成する
AUTH_SECRET=
# Google OAuth クライアント（Google Cloud Console > API とサービス > 認証情報）
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# ログインを許可するドメイン / メール（カンマ区切り。両方空なら誰でも可）
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=
# ローカル開発用のメールだけのログイン（production では常に無効）
AUTH_DEV_LOGIN=false

# --- Vertex AI ---
# 認証は Application Default Credentials（ローカルは `gcloud auth application-default login`）
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=global
# モデル ID の上書き（Model Garden で最新の ID を確認する）
# NEXT_PUBLIC_GEMINI_FLASH_MODEL=gemini-2.5-flash
# NEXT_PUBLIC_GEMINI_PRO_MODEL=gemini-2.5-pro

# GCP なしで動かすときは true（モックの応答を返す）
LLM_MOCK=false
